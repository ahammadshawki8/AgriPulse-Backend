# Environment Variables for Backend

# HuggingFace Space Configuration (REQUIRED)
HF_SPACE_USERNAME=your_username_here
HF_SPACE_NAME=cattle-detection-api

# Flask Configuration
FLASK_ENV=development

# Database (optional - auto-detected on Render)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Note: For local development, SQLite is used automatically
# For production on Render, DATABASE_URL is provided automatically
